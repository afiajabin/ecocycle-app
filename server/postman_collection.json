{
  "info": {
    "_postman_id": "ecocycle-unified-api-collection",
    "name": "EcoCycle - Unified API",
    "description": "Postman collection for EcoCycle with distinct folders for Citizen and Collector modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (Common)",
      "item": [
        {
          "name": "Register User (Citizen / Collector)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Afia Jabin\",\n  \"email\": \"afiajabin12@gmail.com\",\n  \"password\": \"password123\",\n  \"role\": \"collector\",\n  \"district\": \"Dhaka\",\n  \"phone\": \"+880 1712-345678\",\n  \"assignedDistricts\": [\"Dhaka\", \"Gazipur\"],\n  \"vehicleType\": \"Electric Waste Van (EV-04)\",\n  \"vehicleNumber\": \"Dhaka Metro-DH-11-2045\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Collector (Afia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"collector_token\", jsonData.data.token);",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.data.token);",
                  "    console.log(\"Saved Collector JWT Token\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"afiajabin12@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Citizen (Sadia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"citizen_token\", jsonData.data.token);",
                  "    console.log(\"Saved Citizen JWT Token\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sadia.citizen@ecocycle.bd\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Citizen Operations (Her Part)",
      "item": [
        {
          "name": "Create Plastic Pickup Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{citizen_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plasticTypes\": [\"PET Bottles\", \"HDPE Containers\"],\n  \"estimatedKg\": 14.5,\n  \"district\": \"Dhaka\",\n  \"address\": \"House 12, Road 4, Banani, Dhaka\",\n  \"preferredDate\": \"2026-08-31\",\n  \"preferredTime\": \"Morning (9:00 AM - 1:00 PM)\",\n  \"notes\": \"Clean sorted plastic bottles placed at door.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/requests",
              "host": ["{{base_url}}"],
              "path": ["api", "requests"]
            }
          }
        },
        {
          "name": "Get My Submitted Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{citizen_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/requests/my-requests",
              "host": ["{{base_url}}"],
              "path": ["api", "requests", "my-requests"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Collector Operations (Your Part)",
      "item": [
        {
          "name": "Get Collector Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "stats"]
            }
          }
        },
        {
          "name": "Get District Pickup Requests (Queue)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests?status=all",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests"]
            }
          }
        },
        {
          "name": "Step 1: Accept Pickup Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-8903/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-8903", "accept"]
            }
          }
        },
        {
          "name": "Step 2: Collect & Verify Weight (Scale)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verifiedKg\": 15.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-8903/collect",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-8903", "collect"]
            }
          }
        },
        {
          "name": "Step 3: Deliver to Recycling Facility",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facilityId\": \"FACILITY_OBJECT_ID_HERE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-8903/deliver",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-8903", "deliver"]
            }
          }
        },
        {
          "name": "Step 4: Mark Request Completed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collector_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-8903/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-8903", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Facilities",
      "item": [
        {
          "name": "Get All Facilities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/facilities",
              "host": ["{{base_url}}"],
              "path": ["api", "facilities"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "collector_token",
      "value": ""
    },
    {
      "key": "citizen_token",
      "value": ""
    }
  ]
}
