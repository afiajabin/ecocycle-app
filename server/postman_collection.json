{
  "info": {
    "_postman_id": "ecocycle-unified-api-collection",
    "name": "EcoCycle - Unified API",
    "description": "Postman collection for EcoCycle with distinct folders for Common Auth, Citizen, Collector, and Admin modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (Common)",
      "item": [
        {
          "name": "Register User (Citizen / Collector)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Afia Jabin\",\n  \"email\": \"afiajabin12@gmail.com\",\n  \"password\": \"password123\",\n  \"role\": \"collector\",\n  \"district\": \"Dhaka\",\n  \"phone\": \"+880 1712-345678\",\n  \"assignedDistricts\": [\"Dhaka\", \"Gazipur\"],\n  \"vehicleType\": \"Electric Waste Van (EV-04)\",\n  \"vehicleNumber\": \"Dhaka Metro-DH-11-2045\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Collector (Afia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token || (jsonData.data && jsonData.data.token)) {",
                  "    var token = jsonData.token || jsonData.data.token;",
                  "    pm.collectionVariables.set(\"collector_token\", token);",
                  "    pm.collectionVariables.set(\"jwt_token\", token);",
                  "    console.log(\"Saved Collector JWT Token\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"afiajabin12@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token || (jsonData.data && jsonData.data.token)) {",
                  "    var token = jsonData.token || jsonData.data.token;",
                  "    pm.collectionVariables.set(\"admin_token\", token);",
                  "    console.log(\"Saved Admin JWT Token\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecocycle.bd\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Logged-in Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Citizen Operations (Friend)",
      "item": [
        {
          "name": "Submit Pickup Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plasticTypes\": [\"PET Bottles\", \"HDPE Containers\"],\n  \"estimatedKg\": 12,\n  \"district\": \"Dhaka\",\n  \"address\": \"House 12, Road 4, Banani, Dhaka\",\n  \"preferredDate\": \"2026-09-15\",\n  \"preferredTime\": \"10:00 AM\",\n  \"notes\": \"Cleaned and bagged in blue sacks\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/requests",
              "host": ["{{base_url}}"],
              "path": ["api", "requests"]
            }
          }
        },
        {
          "name": "Get My Requests (Citizen)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/requests/my-requests",
              "host": ["{{base_url}}"],
              "path": ["api", "requests", "my-requests"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Collector Operations (Afia)",
      "item": [
        {
          "name": "Get Collector Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "stats"]
            }
          }
        },
        {
          "name": "Get Assigned District Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests?status=all",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests"],
              "query": [{ "key": "status", "value": "all" }]
            }
          }
        },
        {
          "name": "Step 1: Accept Pickup Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-1001/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-1001", "accept"]
            }
          }
        },
        {
          "name": "Step 2: Digital Scale Weighing (Collect)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verifiedKg\": 14.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-1001/collect",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-1001", "collect"]
            }
          }
        },
        {
          "name": "Step 3: Deliver to Facility",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facilityId\": \"67be5691efb0b92b60e6f663\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-1001/deliver",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-1001", "deliver"]
            }
          }
        },
        {
          "name": "Step 4: Finalize Recycling",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collector_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/collector/requests/REQ-BD-1001/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "collector", "requests", "REQ-BD-1001", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Operations (Afia)",
      "item": [
        {
          "name": "Get System-wide Stats (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Get All Collectors Fleet (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/collectors",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "collectors"]
            }
          }
        },
        {
          "name": "Assign Collector Jurisdiction (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedDistricts\": [\"Dhaka\", \"Gazipur\", \"Narayanganj\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/collectors/67be5691efb0b92b60e6f660/jurisdiction",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "collectors", "67be5691efb0b92b60e6f660", "jurisdiction"]
            }
          }
        },
        {
          "name": "Get All Nationwide Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/requests",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "requests"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Recycling Facilities",
      "item": [
        {
          "name": "Get All Facilities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/facilities",
              "host": ["{{base_url}}"],
              "path": ["api", "facilities"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "collector_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ]
}
